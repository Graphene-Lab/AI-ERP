[
  {
    "label": "Debug ErpSite",
    "adapter": "netcoredbg",
    "request": "launch",
    "type": "coreclr",
    "program": "$ZED_WORKTREE_ROOT/WebVella.Erp.Site/bin/Debug/net10.0/WebVella.Erp.Site.dll",
    "cwd": "$ZED_WORKTREE_ROOT/WebVella.Erp.Site",
    "env": {
      "ASPNETCORE_ENVIRONMENT": "Development",
      "ASPNETCORE_URLS": "http://localhost:5000"
    },
    "build": {
      "command": "dotnet",
      "args": [
        "build",
        "$ZED_WORKTREE_ROOT/WebVella.Erp.Site/WebVella.Erp.Site.csproj",
        "-p:Configuration=Debug",
        "-p:TargetFramework=net10.0"
      ]
    }
  }
]
