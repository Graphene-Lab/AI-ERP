[
  {
    "label": "Kill All .Net",
    "command": "pkill -9 -f 'dotnet'",
    "use_new_terminal": false,
  },
  {
    "label": "Solution Build",
    "command": "dotnet",
    "args": [
      "build",
      "-p:WarningLevel=0",
      "-p:NoWarn",
    ],
    "cwd": "$ZED_WORKTREE_ROOT/WebVella.Erp.Site",
  },
  {
      "label": "WebVella.ERP NuGet",
      "command": "dotnet",
      "args": [
        "pack",
        "--configuration Release"
      ],
      "cwd": "$ZED_WORKTREE_ROOT/WebVella.Erp"
    },
]
